# Copy this file to ".env" in the same folder (server/.env) and fill in your own values.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Required ---
PORT=5000
# Local MongoDB:   mongodb://127.0.0.1:27017/social-feed
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/social-feed
MONGO_URI=mongodb://127.0.0.1:27017/social-feed
# Any long random string — used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# URL of your frontend, used for CORS + Socket.io. Vite's default dev URL:
CLIENT_URL=http://localhost:5173

# --- Optional: Cloudinary (image hosting). Without these, uploads are saved
# locally in /server/uploads instead — the app still works fine either way. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: Redis (trending hashtags). Without this, trending hashtags
# are computed from MongoDB instead — the app still works fine either way. ---
# Example: redis://127.0.0.1:6379
REDIS_URL=

# --- Optional: Web Push (browser push notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here AND in client/.env as VITE_VAPID_PUBLIC_KEY. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
