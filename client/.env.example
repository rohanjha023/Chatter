# Copy this file to ".env" in the same folder (client/.env) and adjust if needed.

# Where your backend REST API is running.
VITE_API_URL=http://localhost:5000/api

# Where your backend Socket.io server is running (usually same host/port as above, no /api).
VITE_SOCKET_URL=http://localhost:5000

# Optional: only needed if you set up Web Push (see server/.env.example).
# Must be the SAME public key as VAPID_PUBLIC_KEY on the server.
VITE_VAPID_PUBLIC_KEY=
